                            <TableColumn fx:id="tcPairName" editable="false" maxWidth="400.0" minWidth="50.0" prefWidth="200.0" sortable="false" text="Pair Name" />
                            <TableColumn fx:id="tcPairSourcePath" editable="false" maxWidth="1000.0" prefWidth="605.3999786376953" sortable="false" text="Source Path" />
                          </columns>
                        </TableView>
                                <VBox alignment="TOP_RIGHT">
                                    <children>
                                        <Button fx:id="btnMovePairTop" mnemonicParsing="false" onAction="#OnMovePairTop" text="Top" />
                                        <Button fx:id="btnMovePairUp" mnemonicParsing="false" onAction="#OnMovePairUp" text="Up" />
                                        <Button fx:id="btnMovePairDown" mnemonicParsing="false" onAction="#OnMovePairDown" text="Down" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
