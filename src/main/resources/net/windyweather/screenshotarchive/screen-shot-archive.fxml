                        </HBox>
                                <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0">
                                    <children>
                              <TextField fx:id="txtStatus" editable="false" onKeyPressed="#OnKeyPressedStatus" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets right="40.0" />
                                 </HBox.margin>
                              </TextField>
                                        <Button fx:id="btnCloseAppButton" mnemonicParsing="false" onAction="#OnCloseAppButton" text="Close">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </VBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets top="10.0" />
            </padding></AnchorPane>
    </items>
    <padding>
        <Insets left="10.0" right="10.0" />
    </padding>
</SplitPane>
